# Ghostty config.
# Reload after editing: cmd+shift+,  (Ghostty does not watch this file)

theme = Nord

# No font-family on purpose: Ghostty then uses its built-in JetBrains Mono,
# and its built-in Symbols Nerd Font for icons. font-style is left out too,
# because Ghostty ignores it without a font-family. 18 is larger than the
# default of 13.
font-size = 18

# Removes the dark fringe around coloured text (red on green and similar)
# while keeping text weight close to macOS's own blending (native, the
# macOS default).
alpha-blending = linear-corrected

# Lifts text that is almost the same colour as the background so it never
# disappears. 1.1 is the docs' value for "avoid invisible text"; it is low
# enough to leave the theme's normal colours alone (the default, 1, does
# nothing).
minimum-contrast = 1.1

# A steady cursor, calmer on the eyes. Programs such as Neovim can still
# ask for a blinking one.
cursor-style-blink = false

# See-through, blurred background. At 0.80 (tuned by eye) the desktop
# shows through but text stays easy to read; 20 is Ghostty's own default
# blur strength. The colour is darker than Nord's #2e3440 so text stays
# readable over a bright desktop. On macOS, a change to background-opacity
# needs a full quit and reopen of Ghostty, not a reload.
background = #1c1f2a
background-opacity = 0.80
background-blur = 20

# A thin gap at the sides and none at the top and bottom (the default is 2
# on every side).
window-padding-x = 3
window-padding-y = 0

# The window is rarely an exact number of cells, so a sliver of space is
# left over. Spread it over all four edges instead of piling it up on the
# right and bottom (true caps the top share and puts the rest at the bottom).
window-padding-balance = true

# Dock and app-switcher icon; the glass variant suits the blurred,
# see-through window. Finder keeps the official icon (macOS limitation).
macos-icon = glass

# Always ask before closing a window or tab, even when nothing is running.
# The default (true) asks only while a program is still running.
confirm-close-surface = always
